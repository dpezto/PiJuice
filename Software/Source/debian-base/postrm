#!/bin/sh
set -e
#
# Remove installed symbolic links
if [ "$1" = "remove" ]; then
	if [ -L /usr/lib/python3/dist-packages/pijuice.py ]; then
		rm /usr/lib/python3/dist-packages/pijuice.py
	fi
	if [ -L /usr/bin/pijuiceboot ]; then
		rm /usr/bin/pijuiceboot
	fi
	if [ -L /usr/bin/pijuice_cli ]; then
		rm /usr/bin/pijuice_cli
	fi
fi

# Unregister the pijuice_power DKMS module (built in postinst).
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	if command -v dkms > /dev/null 2>&1; then
		for v in $(dkms status -m pijuice-power 2>/dev/null | sed -n 's|^pijuice-power/\([^,]*\),.*|\1|p' | sort -u); do
			dkms remove -m pijuice-power -v "$v" --all || true
		done
	fi
fi

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#
