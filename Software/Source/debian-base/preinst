#!/bin/sh
set -e
#
# Remove the symlink older packages' postinst created in /usr/lib/python3/dist-packages;
# pijuice.py is now shipped there as a real file.

if [ -L /usr/lib/python3/dist-packages/pijuice.py ]; then
    rm /usr/lib/python3/dist-packages/pijuice.py
fi

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.
#DEBHELPER#
