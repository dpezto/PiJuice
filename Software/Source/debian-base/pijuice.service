[Unit]
Description=PiJuice status service
Requires=dev-i2c\x2d1.device
After=dev-i2c\x2d1.device

[Service]
Type=idle
User=pijuice
WorkingDirectory=/var/lib/pijuice/
# /run/pijuice holds the daemon pid and the CLI/GUI single-instance locks.
RuntimeDirectory=pijuice
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
# Background work: yield the CPU to the Pi's real job. The checks need a few
# ms every 5 s, which a niced process still gets on a busy single core.
Nice=10
ExecStart=/usr/bin/pijuice_sys.py
ExecStopPost=/usr/bin/pijuice_sys.py stop
Restart=always

[Install]
WantedBy=multi-user.target
